{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/display", "custom/hardware", "network", "custom/bluetooth", "custom/audio", "clock", "custom/power"],
    "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
    },
    "sway/window": {
        "max-length": 80
    },
    "custom/display": {
        "exec": "display-status",
        "interval": 1,
        "tooltip": true,
        "on-click": "display-menu"
    },
    "custom/hardware": {
        "exec": "hardware-stats",
        "interval": 2,
        "return-type": "json",
        "tooltip": true,
        "on-click-right": "alacritty -e ncdu -x /"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "Wi-Fi connected: {essid}",
        "tooltip-format-disconnected": "Wi-Fi disconnected",
        "on-click": "sh -c 'nmcli device wifi rescan; alacritty -e nmtui'",
        "on-click-right": "sh -c 'nmcli device wifi rescan; alacritty -e nmtui'"
    },
    "custom/bluetooth": {
        "format": "󰂯",
        "tooltip": true,
        "tooltip-format": "Bluetooth",
        "on-click": "alacritty -e bluetui",
        "on-click-right": "alacritty -e bluetui"
    },
    "custom/audio": {
        "exec": "audio-status",
        "interval": 1,
        "return-type": "json",
        "escape": false,
        "on-click": "mic-toggle",
        "on-click-right": "alacritty -e wiremix"
    },
    "clock": {
        "format": "{:%b %d %H:%M}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "power-menu"
    }
}
