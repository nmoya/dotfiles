{
    "layer": "top",
    "position": "top",
    "height": 34,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/display", "custom/hardware-cpu", "custom/hardware-gpu", "custom/hardware-ram", "custom/hardware-storage", "custom/hardware-network", "custom/bluetooth", "custom/audio", "clock", "custom/power"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "{name}",
        "window-rewrite": {
            "class<firefox>": "",
            "class<Alacritty>": "",
            "class<code>": "󰨞",
            "class<Spotify>": "",
            "class<vesktop>": "󰙯",
            "class<org.telegram.desktop>": "",
            "class<steam>": "",
            "class<Godot>": "",
            "class<github-desktop>": "",
            "class<org.gnome.Nautilus>": "󰉋",
            "class<org.gnome.Calculator>": "",
            "class<org.gnome.Calendar>": "󰃭",
            "class<org.gnome.clocks>": "󰥔",
            "class<org.gnome.Characters>": "󰦨",
            "class<org.gnome.Console>": "",
            "class<org.gnome.TextEditor>": "󰈙",
            "class<org.gnome.Settings>": "",
            "class<org.gnome.SystemMonitor>": "󰍛",
            "class<gnome-system-monitor>": "󰍛",
            "class<org.gnome.DiskUtility>": "",
            "class<org.gnome.baobab>": "󰋊",
            "class<org.gnome.Loupe>": "",
            "class<org.gnome.Snapshot>": "",
            "class<org.gnome.Showtime>": "",
            "class<org.gnome.Music>": "",
            "class<org.gnome.Decibels>": "",
            "class<org.gnome.Papers>": "",
            "class<org.gnome.Epiphany>": "",
            "class<org.gnome.Maps>": "󰆋",
            "class<org.gnome.Weather>": "󰖐",
            "class<org.gnome.Contacts>": "󰛋",
            "class<org.gnome.Connections>": "󰌘",
            "class<org.gnome.Logs>": "󰌱",
            "class<org.gnome.Extensions>": "",
            "class<org.gnome.seahorse.Application>": "",
            "class<org.gnome.SimpleScan>": "󰚫",
            "class<org.gnome.font-viewer>": "",
            "class<gnome-font-viewer>": "",
            "class<blueman-manager>": "󰂯",
            "class<blueman-adapters>": "󰂯",
            "class<nvidia-settings>": "󰾲",
            "class<Bazecor>": "󰌌",
            "class<foot>": "",
            "class<footclient>": "",
            "class<XTerm>": "",
            "class<gvim>": "",
            "class<Gvim>": ""
        }
    },
    "sway/window": {
        "max-length": 80
    },
    "custom/display": {
        "exec": "display-status",
        "interval": 1,
        "tooltip": true,
        "on-click": "display-menu"
    },
    "custom/hardware-cpu": {
        "exec": "hardware-cpu",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },
    "custom/hardware-gpu": {
        "exec": "hardware-gpu",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },
    "custom/hardware-ram": {
        "exec": "hardware-ram",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },
    "custom/hardware-storage": {
        "exec": "hardware-storage",
        "interval": 10,
        "return-type": "json",
        "tooltip": true,
        "on-click": "alacritty -e ncdu -x /",
        "on-click-right": "alacritty -e ncdu -x /"
    },
    "custom/hardware-network": {
        "exec": "hardware-network",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "sh -c 'nmcli device wifi rescan; alacritty -e nmtui'",
        "on-click-right": "sh -c 'nmcli device wifi rescan; alacritty -e nmtui'"
    },
    "custom/bluetooth": {
        "format": "󰂯",
        "tooltip": true,
        "tooltip-format": "Bluetooth",
        "on-click": "alacritty -e bluetui",
        "on-click-right": "alacritty -e bluetui"
    },
    "custom/audio": {
        "exec": "audio-status",
        "interval": 1,
        "return-type": "json",
        "escape": false,
        "on-click": "mic-toggle",
        "on-click-right": "alacritty -e wiremix"
    },
    "clock": {
        "format": "{:%b %d %H:%M}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "power-menu"
    }
}
