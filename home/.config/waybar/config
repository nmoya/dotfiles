{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/display", "cpu", "custom/gpu", "memory", "disk", "custom/audio", "clock", "custom/power"],
    "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
    },
    "sway/window": {
        "max-length": 80
    },
    "custom/display": {
        "exec": "display-status",
        "interval": 1,
        "tooltip": true,
        "on-click": "display-menu"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },
    "custom/gpu": {
        "exec": "gpu-status",
        "interval": 2,
        "tooltip": false
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 5
    },
    "disk": {
        "path": "/",
        "format": " {percentage_used}%",
        "interval": 30
    },
    "custom/audio": {
        "exec": "audio-status",
        "interval": 1,
        "return-type": "json",
        "escape": false,
        "on-click": "mic-toggle",
        "on-click-right": "alacritty -e wiremix"
    },
    "clock": {
        "format": "{:%b %d %H:%M}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "power-menu"
    }
}
