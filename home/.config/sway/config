# Important on NixOS.
include /etc/sway/config.d/*

set $mod Mod4

set $term alacritty
set $menu wmenu-run

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu

# Display profiles
bindsym $mod+Ctrl+1 exec display-daily
bindsym $mod+Ctrl+2 exec display-monitor-gaming
bindsym $mod+Ctrl+3 exec display-mirror-casual
bindsym $mod+Ctrl+4 exec display-mirror-gaming
bindsym $mod+Ctrl+5 exec display-tv-gaming

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen

# Reload / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit