# Important on NixOS.
include /etc/sway/config.d/*

# defaults
set $super Mod4
set $lalt Mod1
set $term alacritty
set $menu styled-wmenu-run

# Automount external hardrives
exec udiskie --automount --notify

exec display-daily
exec waybar
workspace_layout tabbed
# Decides horizontal/vertical split based on container size
default_orientation auto
default_border pixel 2
default_floating_border pixel 2
# Mouse and Keyboard
seat seat0 xcursor_theme Adwaita 24
input type:keyboard {
    xkb_layout us
    xkb_variant intl
}

bindsym $super+Return exec $term
bindsym $super+d exec $menu

# Display profiles
bindsym $super+Ctrl+d exec display-menu
bindsym $super+Ctrl+1 exec display-daily
bindsym $super+Ctrl+2 exec display-monitor-gaming
bindsym $super+Ctrl+3 exec display-mirror-casual
bindsym $super+Ctrl+4 exec display-mirror-gaming
bindsym $super+Ctrl+5 exec display-tv-gaming

# Layout
bindsym $super+b splith
bindsym $super+v splitv
bindsym $super+s layout stacking
bindsym $super+w layout tabbed
bindsym $super+e layout toggle split
bindsym $super+f fullscreen

bindsym $super+Shift+Left move left
bindsym $super+Shift+Right move right
bindsym $super+Shift+Up move up
bindsym $super+Shift+Down move down

bindsym $super+Shift+q kill

# Focus
bindsym $super+Left focus left
bindsym $super+Right focus right
bindsym $super+Up focus up
bindsym $super+Down focus down
bindsym $super+Shift+t focus parent, layout toggle split, focus child
bindsym $super+a focus parent

# Reload / exit
bindsym $super+Shift+c reload
bindsym $super+Shift+e exit

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $super+1 workspace $ws1
bindsym $super+2 workspace $ws2
bindsym $super+3 workspace $ws3
bindsym $super+4 workspace $ws4
bindsym $super+5 workspace $ws5
bindsym $super+6 workspace $ws6
bindsym $super+7 workspace $ws7
bindsym $super+8 workspace $ws8
bindsym $super+9 workspace $ws9
bindsym $super+0 workspace $ws10
bindsym $lalt+1 workspace $ws1
bindsym $lalt+2 workspace $ws2
bindsym $lalt+3 workspace $ws3
bindsym $lalt+4 workspace $ws4
bindsym $lalt+5 workspace $ws5
bindsym $lalt+6 workspace $ws6
bindsym $lalt+7 workspace $ws7
bindsym $lalt+8 workspace $ws8
bindsym $lalt+9 workspace $ws9
bindsym $lalt+0 workspace $ws10

bindsym $super+Shift+1 move container to workspace $ws1
bindsym $super+Shift+2 move container to workspace $ws2
bindsym $super+Shift+3 move container to workspace $ws3
bindsym $super+Shift+4 move container to workspace $ws4
bindsym $super+Shift+5 move container to workspace $ws5
bindsym $super+Shift+6 move container to workspace $ws6
bindsym $super+Shift+7 move container to workspace $ws7
bindsym $super+Shift+8 move container to workspace $ws8
bindsym $super+Shift+9 move container to workspace $ws9
bindsym $super+Shift+0 move container to workspace $ws10
bindsym $lalt+Shift+1 move container to workspace $ws1
bindsym $lalt+Shift+2 move container to workspace $ws2
bindsym $lalt+Shift+3 move container to workspace $ws3
bindsym $lalt+Shift+4 move container to workspace $ws4
bindsym $lalt+Shift+5 move container to workspace $ws5
bindsym $lalt+Shift+6 move container to workspace $ws6
bindsym $lalt+Shift+7 move container to workspace $ws7
bindsym $lalt+Shift+8 move container to workspace $ws8
bindsym $lalt+Shift+9 move container to workspace $ws9
bindsym $lalt+Shift+0 move container to workspace $ws10

bindsym $super+Tab focus next
bindsym $super+Shift+Tab focus prev
bindsym $lalt+Tab workspace next
bindsym $lalt+Shift+Tab workspace prev

# Audio
bindsym $super+minus exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-
bindsym $super+equal exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+
bindsym $super+bracketleft exec mic-toggle

# Screenshots
bindsym $super+Shift+s exec sh -c 'grim -g "$(slurp)" - | wl-copy'
