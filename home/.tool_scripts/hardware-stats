#!/usr/bin/env bash
set -euo pipefail

read_cpu() {
    read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
    idle_total=$((idle + iowait))
    total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    printf '%s %s\n' "$total" "$idle_total"
}

read -r total_a idle_a < <(read_cpu)
sleep 0.1
read -r total_b idle_b < <(read_cpu)

total_delta=$((total_b - total_a))
idle_delta=$((idle_b - idle_a))
if [[ "$total_delta" -gt 0 ]]; then
    cpu_percent=$(((100 * (total_delta - idle_delta)) / total_delta))
else
    cpu_percent=0
fi

mem_total=0
mem_available=0
while read -r key value _; do
    case "$key" in
        MemTotal:) mem_total="$value" ;;
        MemAvailable:) mem_available="$value" ;;
    esac
done < /proc/meminfo
mem_percent=$(((100 * (mem_total - mem_available)) / mem_total))

disk_percent="$(df --output=pcent / | {
    read -r _
    read -r percent
    printf '%s' "${percent//[^0-9]/}"
})"

nvidia_smi="${NVIDIA_SMI:-/run/current-system/sw/bin/nvidia-smi}"
if [[ -x "$nvidia_smi" ]]; then
    IFS=',' read -r gpu_percent gpu_mem_used gpu_mem_total gpu_temp < <(
        "$nvidia_smi" --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits
    )
    gpu_percent="${gpu_percent// /}"
    gpu_mem_used="${gpu_mem_used// /}"
    gpu_mem_total="${gpu_mem_total// /}"
    gpu_temp="${gpu_temp// /}"
    gpu_mem_percent=$((gpu_mem_used * 100 / gpu_mem_total))
else
    gpu_percent=0
    gpu_mem_percent=0
    gpu_temp=0
fi

text=" ${cpu_percent} 󰢮 ${gpu_percent}  ${mem_percent}  ${disk_percent}"
tooltip="CPU: ${cpu_percent}%\\nGPU: ${gpu_percent}%\\nVRAM: ${gpu_mem_percent}%\\nGPU Temp: ${gpu_temp}°C\\nMemory: ${mem_percent}%\\nDisk: ${disk_percent}%"

printf '{"text":"%s","tooltip":"%s"}\n' "$text" "$tooltip"
