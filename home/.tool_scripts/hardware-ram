#!/usr/bin/env bash
set -euo pipefail

mem_total=0
mem_available=0
while read -r key value _; do
    case "$key" in
        MemTotal:) mem_total="$value" ;;
        MemAvailable:) mem_available="$value" ;;
    esac
done < /proc/meminfo

mem_used=$((mem_total - mem_available))
mem_percent=$(((100 * mem_used) / mem_total))
used_tenths=$(((mem_used * 10 + 524288) / 1048576))
total_tenths=$(((mem_total * 10 + 524288) / 1048576))
available_tenths=$(((mem_available * 10 + 524288) / 1048576))

used_gb="$((used_tenths / 10)).$((used_tenths % 10))"
total_gb="$((total_tenths / 10)).$((total_tenths % 10))"
available_gb="$((available_tenths / 10)).$((available_tenths % 10))"

text=" ${used_gb}GB ${mem_percent}%"
tooltip="RAM used: ${used_gb} GB (${mem_percent}%)\\nAvailable: ${available_gb} GB\\nTotal: ${total_gb} GB"

printf '{"text":"%s","tooltip":"%s"}\n' "$text" "$tooltip"
